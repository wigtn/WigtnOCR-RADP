# ─── Dataset / Models (재현 가능, HF에서 다운로드) ────────
data/*
!data/.gitkeep
# KoGovDoc-RAG probe: the 663-Q–A eval set the paper says it releases — committed
# so "we release the frozen eval set" is true in-repo (private repo). Note the
# dir must be un-ignored (data/*) before its files can be re-included.
!data/KoGovDoc-RAG/
data/KoGovDoc-RAG/*
!data/KoGovDoc-RAG/qa_pairs_v1.jsonl
!data/KoGovDoc-RAG/page_split_v1.json
!data/KoGovDoc-RAG/qa_verification_sample_v1.jsonl
!data/KoGovDoc-RAG/qa_verification_results_v1.json
output/*
!output/.gitkeep
# Evaluation metrics & diagnostics backing the paper/rebuttal (small JSONs;
# training checkpoints and per-QA training dumps stay ignored).
!output/baselines/
output/baselines/*
!output/baselines/*.json
!output/diagnostics/
output/diagnostics/*
!output/diagnostics/*.json
!output/diagnostics/*.md
!output/diagnostics/absent_llm_judge_cache.jsonl
!output/results/
output/results/*
!output/results/e2e_rag.json
!output/results/e2e_rag_detail.jsonl
!output/results/ohrbench_noise.json
!output/results/ohrbench_bc_noise.json
!output/results/ohrbench_7dom_rcps.json
!output/results/ohrbench_7dom_bc.json
!output/results/ohrbench_crossdomain.json
!output/results/ohrbench_per_domain.json
!output/results/ohrbench_alignment_audit.json
!output/results/MANIFEST.legacy-invalid.sha256
!output/results/grid_MinerU-tableON_parser_native.json
!output/results/perqa_MinerU-tableON_parser_native.json
!output/results/fullgrid_aggregate_audit.json
!output/results/rcps_protocol_ablation.json
!output/results/rank_stability_e2e_accuracy.json

